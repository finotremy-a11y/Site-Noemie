<% content_for :meta_description, [@product.name, @product.description].compact.join(" - ").truncate(155) %>

<div class="page-product-detail" data-controller="cart">
  <div class="product-detail-container">
    <div class="product-detail-actions">
      <%= link_to "← Retour à la carte", catalog_path, class: "breadcrumb-link" %>
      <%= link_to "Voir le panier", cart_path, class: "btn-outline btn-inline" %>
    </div>

    <div class="product-detail-grid">
      <div class="product-detail-image">
        <% if @product.image_url.present? %>
          <img src="<%= @product.image_url %>" alt="<%= @product.name %>" class="product-img-large">
        <% else %>
          <div class="product-img-placeholder" aria-hidden="true">
            <span>🍔</span>
          </div>
        <% end %>
      </div>

      <div class="product-detail-info">
        <div class="product-meta-list">
          <% if @product.category %>
            <span class="product-meta-chip"><%= @product.category.name %></span>
          <% end %>
          <span class="product-meta-chip"><%= @product.available? ? "Disponible aujourd'hui" : "Indisponible actuellement" %></span>
          <% if @product.options? %>
            <span class="product-meta-chip">Options personnalisables</span>
          <% end %>
        </div>

        <h1 class="product-title"><%= @product.name %></h1>

        <% if @product.description.present? %>
          <p class="product-description"><%= @product.description %></p>
        <% end %>

        <div class="product-price-block">
          <span class="product-price-main"><%= number_to_currency(@product.price_cents / 100.0, unit: "€", format: "%n %u") %></span>
          <span class="product-price-note">Prix affiché hors options éventuelles.</span>
        </div>

        <% if @product.product_options.any? %>
          <div class="product-options">
            <h2>Options</h2>
            <% @product.product_options.each do |option| %>
              <label class="option-row">
                <input type="checkbox" name="option_<%= option.id %>" value="<%= option.id %>">
                <span class="option-name"><%= option.name %></span>
                <% if option.price_delta_cents > 0 %>
                  <span class="option-price">+ <%= number_to_currency(option.price_delta_cents / 100.0, unit: "€", format: "%n %u") %></span>
                <% end %>
              </label>
            <% end %>
          </div>
        <% end %>

        <% if @product.available? %>
          <%= form_with url: cart_items_path, method: :post, class: "add-to-cart-form", local: true do |f| %>
            <%= f.hidden_field :product_id, value: @product.id %>
            <div class="quantity-selector">
              <%= f.label :quantity, "Quantité" %>
              <div class="quantity-controls">
                <button type="button" class="qty-btn" data-action="click->cart#decrease">−</button>
                <%= f.number_field :quantity, value: 1, min: 1, max: [@product.stock_quantity.to_i, 10].min, class: "qty-input", data: { cart_target: "quantity" } %>
                <button type="button" class="qty-btn" data-action="click->cart#increase">+</button>
              </div>
            </div>

            <div class="field">
              <%= f.label :special_instructions, "Instructions spéciales (optionnel)" %>
              <%= f.text_area :special_instructions, placeholder: "Sans oignons, sauce séparée...", rows: 3, class: "form-textarea" %>
            </div>

            <%= f.submit "Ajouter au panier", class: "btn-primary btn-large btn-block" %>
          <% end %>
        <% else %>
          <div class="out-of-stock-badge">Indisponible actuellement</div>
        <% end %>
      </div>
    </div>

    <div class="product-reassurance">
      <div class="reassurance-item">
        <strong>Préparation minute</strong>
        <span>Chaque commande est préparée à la demande pour garder texture et chaleur.</span>
      </div>
      <div class="reassurance-item">
        <strong>Commande flexible</strong>
        <span>Ajoutez vos préférences et vos instructions spéciales avant validation.</span>
      </div>
      <div class="reassurance-item">
        <strong>Suivi simplifié</strong>
        <span>Retrouvez votre commande, vos factures et vos statuts depuis votre espace client.</span>
      </div>
    </div>

    <% if @reviews&.any? %>
      <section class="product-section">
        <div class="section-heading compact">
          <h2>Avis clients (<%= @reviews.count %>)</h2>
          <p>Un aperçu des derniers retours validés sur ce produit.</p>
        </div>
        <div class="reviews-grid">
          <% @reviews.each do |review| %>
            <div class="review-card-small">
              <div class="review-stars">
                <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
              </div>
              <p class="review-comment"><%= review.comment %></p>
              <span class="review-date"><%= l(review.created_at, format: :short) %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% else %>
      <section class="product-section review-empty-state">
        <h2>Pas encore d'avis sur ce produit</h2>
        <p>Soyez parmi les premiers à partager votre expérience après votre commande.</p>
        <%= link_to "Consulter tous les avis", reviews_path, class: "btn-secondary" %>
      </section>
    <% end %>

    <% if @related_products.any? %>
      <section class="product-section">
        <div class="section-heading compact">
          <h2>À découvrir aussi</h2>
          <p>D'autres produits de la même catégorie pour compléter votre commande.</p>
        </div>
        <div class="products-grid">
          <% @related_products.each do |related_product| %>
            <%= render "catalog/product_card", product: related_product %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>

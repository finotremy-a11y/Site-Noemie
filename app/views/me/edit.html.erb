<div class="page-account">
  <section class="section-header">
    <h1>Mon Compte — Modifier mon profil</h1>
  </section>

  <div class="account-container">
    <aside class="account-menu">
      <nav class="menu-nav">
        <a href="<%= me_path %>" class="menu-item">👤 Profil</a>
        <a href="<%= me_orders_path %>" class="menu-item">📦 Mes commandes</a>
        <a href="<%= me_addresses_path %>" class="menu-item">📍 Adresses</a>
        <a href="<%= me_preferences_path %>" class="menu-item">⚙️ Préférences</a>
        <hr>
        <%= link_to "Déconnexion", logout_path, data: { turbo_method: :post }, class: "menu-item menu-danger" %>
      </nav>
    </aside>

    <div class="account-main">
      <div class="account-card">
        <h3>Modifier mes informations</h3>

        <%= form_with url: me_path, method: :patch, class: "form-vertical" do |f| %>
          <div class="field">
            <label>Prénom</label>
            <%= f.text_field :first_name, value: @user.first_name, placeholder: "Votre prénom", class: "form-input", name: "user[first_name]" %>
          </div>
          <div class="field">
            <label>Nom</label>
            <%= f.text_field :last_name, value: @user.last_name, placeholder: "Votre nom", class: "form-input", name: "user[last_name]" %>
          </div>
          <div class="field">
            <label>Email</label>
            <%= f.email_field :email, value: @user.email, class: "form-input", name: "user[email]" %>
          </div>
          <div class="field">
            <label>Téléphone</label>
            <%= f.telephone_field :phone, value: @user.phone, placeholder: "06 34 93 68 01", class: "form-input", name: "user[phone]" %>
          </div>

          <div class="form-actions">
            <%= f.submit "Enregistrer", class: "btn-primary" %>
            <%= link_to "Annuler", me_path, class: "btn-outline" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

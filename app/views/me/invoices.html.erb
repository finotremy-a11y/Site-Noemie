<div class="page-account">
  <section class="section-header">
    <h1>Mes Factures</h1>
  </section>

  <div class="account-container">
    <aside class="account-menu">
      <nav class="menu-nav">
        <a href="<%= me_path %>" class="menu-item">👤 Profil</a>
        <a href="<%= me_orders_path %>" class="menu-item">📦 Mes commandes</a>
        <a href="<%= me_addresses_path %>" class="menu-item">📍 Adresses</a>
        <a href="<%= me_preferences_path %>" class="menu-item">⚙️ Préférences</a>
        <a href="<%= me_invoices_path %>" class="menu-item active">📄 Factures</a>
        <hr>
        <%= link_to "Déconnexion", logout_path, data: { turbo_method: :post }, class: "menu-item menu-danger" %>
      </nav>
    </aside>

    <div class="account-main">
      <% if @invoices.any? %>
        <div class="orders-list">
          <% @invoices.each do |invoice| %>
            <div class="order-row">
              <div class="order-row-number">
                <span class="label">Facture</span>
                <span class="value amber"><%= invoice.invoice_number %></span>
              </div>
              <div class="order-row-date">
                <span class="label">Date</span>
                <span class="value"><%= l(invoice.issued_at || invoice.created_at, format: :short) %></span>
              </div>
              <div class="order-row-status">
                <span class="status-badge status-<%= invoice.status %>"><%= invoice.status.humanize %></span>
              </div>
              <div class="order-row-total">
                <span class="amber bold"><%= number_to_currency(invoice.total_cents / 100.0, unit: "€", format: "%n %u") %></span>
              </div>
              <div>
                <%= link_to "Voir", me_invoice_path(invoice), class: "btn-small" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <span class="empty-icon">📄</span>
          <h3>Aucune facture disponible</h3>
          <p>Vos factures apparaîtront ici dès qu'une commande sera réglée.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
.orders-list { display: flex; flex-direction: column; gap: .75rem; }
.order-row { background: #181818; border: 1px solid #222; border-radius: 10px; padding: 1.2rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.order-row-number .label, .order-row-date .label { color: #666; font-size: .75rem; display: block; margin-bottom: .2rem; }
.order-row-number .value, .order-row-date .value { color: #f0ece4; font-size: .95rem; }
.amber { color: #b23a30; }
.bold { font-weight: 700; }
.status-badge { padding: .3rem .8rem; border-radius: 20px; font-size: .78rem; background: #22c55e22; color: #22c55e; border: 1px solid #22c55e44; }
.empty-state { text-align: center; padding: 4rem 2rem; color: #888; }
.empty-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
.empty-state h3 { color: #f0ece4; margin-bottom: .5rem; }
</style>
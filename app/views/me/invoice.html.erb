<div class="page-account">
  <section class="section-header">
    <h1>Facture <%= @invoice.invoice_number %></h1>
  </section>

  <div class="account-container">
    <aside class="account-menu">
      <nav class="menu-nav">
        <a href="<%= me_path %>" class="menu-item">👤 Profil</a>
        <a href="<%= me_orders_path %>" class="menu-item">📦 Mes commandes</a>
        <a href="<%= me_addresses_path %>" class="menu-item">📍 Adresses</a>
        <a href="<%= me_preferences_path %>" class="menu-item">⚙️ Préférences</a>
        <a href="<%= me_invoices_path %>" class="menu-item active">📄 Factures</a>
        <hr>
        <%= link_to "Déconnexion", logout_path, data: { turbo_method: :post }, class: "menu-item menu-danger" %>
      </nav>
    </aside>

    <div class="account-main">
      <div class="account-card">
        <div class="card-header">
          <h3>Détails de la facture</h3>
          <% if @invoice.pdf_ready? %>
            <%= link_to "Télécharger PDF", download_me_invoice_path(@invoice), class: "btn-small" %>
          <% end %>
        </div>

        <div class="info-grid">
          <div class="info-item">
            <span class="label">Commande</span>
            <span class="value"><%= @invoice.order.order_number %></span>
          </div>
          <div class="info-item">
            <span class="label">Date d'émission</span>
            <span class="value"><%= l(@invoice.issued_at || @invoice.created_at, format: :long) %></span>
          </div>
          <div class="info-item">
            <span class="label">Statut</span>
            <span class="value"><%= @invoice.status.humanize %></span>
          </div>
          <div class="info-item">
            <span class="label">Montant</span>
            <span class="value amber"><%= number_to_currency(@invoice.total_cents / 100.0, unit: "€", format: "%n %u") %></span>
          </div>
        </div>

        <% unless @invoice.pdf_ready? %>
          <p class="empty-state">Le PDF est en cours de génération.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
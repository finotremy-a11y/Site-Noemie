<div class="page-contact">
  <section class="section-header">
    <h1>Nous Contacter</h1>
    <p>Une question? Une demande de devis? Contactez-nous!</p>
  </section>

  <div class="contact-container">
    <div class="contact-form-section">
      <h2>Formulaire de contact</h2>

      <%= form_with url: contacts_path, local: true, method: :post, class: "contact-form" do |f| %>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Nom *</label>
            <%= f.text_field :name, required: true, placeholder: "Votre nom" %>
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <%= f.email_field :email, required: true, placeholder: "votre@email.fr" %>
          </div>
        </div>

        <div class="form-group">
          <label for="phone">Téléphone (optionnel)</label>
          <%= f.telephone_field :phone, placeholder: "06 34 93 68 01" %>
        </div>

        <div class="form-group">
          <label for="subject">Sujet *</label>
          <%= f.select :subject, %w[Autre Question Réclamation Partenariat Événement], { prompt: "Sélectionnez un sujet" }, { required: true } %>
        </div>

        <div class="form-group">
          <label for="message">Message *</label>
          <%= f.text_area :message, required: true, rows: 6, placeholder: "Votre message..." %>
        </div>

        <button type="submit" class="btn-primary btn-block">
          Envoyer
        </button>
      <% end %>
    </div>

    <aside class="contact-info-section">
      <div class="info-card">
        <h3>📞 Par téléphone</h3>
        <p>
          <strong>06 34 93 68 01</strong><br>
          <small>Lun - Dim: 12h00 - 21h00</small>
        </p>
      </div>

      <div class="info-card">
        <h3>📧 Par email</h3>
        <p>
          <a href="mailto:contact@nlcuisinent.fr">contact@nlcuisinent.fr</a>
        </p>
      </div>

      <div class="info-card">
        <h3>🚗 Où nous trouver</h3>
        <p>
          N&L Cuisinent<br>
          Food Truck<br>
          Paris, France
        </p>
      </div>

      <div class="info-card">
        <h3>⏰ Horaires</h3>
        <p>
          <strong>Lun - Jeu:</strong> 11h30 - 20h30<br>
          <strong>Ven - Sam:</strong> 11h30 - 22h00<br>
          <strong>Dimanche:</strong> 12h00 - 20h00
        </p>
      </div>
    </aside>
  </div>
</div>

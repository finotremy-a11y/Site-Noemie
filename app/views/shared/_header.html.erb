<% cart_count = current_cart_items_count %>

<header class="header">
  <div class="header-top">
    <div class="status-bar">
      Burgers premium · Retrait & livraison autour de Barbentane · Commandes jusqu'à 20h30
    </div>
  </div>

  <nav class="navbar" aria-label="Navigation principale">
    <div class="navbar-container" data-nav-root>
      <a href="<%= root_path %>" class="logo" aria-label="Retour à l'accueil">
        <strong>N&amp;L</strong> <span>Cuisinent</span>
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-label="Ouvrir le menu de navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <div class="nav-panel" id="mobile-nav" data-nav-panel>
        <ul class="nav-menu">
          <li><%= link_to "Carte", catalog_path %></li>
          <li><%= link_to "Commander", checkout_path %></li>
          <li><%= link_to "Événements", root_path(anchor: "events") %></li>
          <li><%= link_to "Avis", reviews_path %></li>
          <li><%= link_to "Contact", contact_path %></li>
        </ul>

        <div class="nav-actions">
          <a href="tel:+33634936801" class="nav-link nav-link-compact">
            <span class="icon">☎</span> 06 34 93 68 01
          </a>

          <% if current_user %>
            <a href="<%= me_path %>" class="nav-link">
              <span class="icon">👤</span> <%= current_user.email %>
            </a>
            <%= link_to "Déconnexion", logout_path, data: { turbo_method: :post }, class: "btn-outline" %>
          <% else %>
            <%= link_to "Connexion", login_path, class: "btn-outline" %>
            <%= link_to "Inscription", register_path, class: "btn-outline" %>
          <% end %>

          <a href="<%= cart_path %>" class="btn-primary cart-toggle" aria-label="Mon panier, <%= cart_count %> article<%= "s" unless cart_count == 1 %>">
            <span class="icon">🛒</span> Mon panier
            <span class="cart-badge" id="cart-count" <%= "hidden" if cart_count.zero? %>><%= cart_count %></span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

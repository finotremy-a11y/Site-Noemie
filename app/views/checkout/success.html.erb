<div class="page-checkout-success">
  <div class="success-container">
    <div class="success-icon">✓</div>
    <h1>Commande confirmée !</h1>
    <p class="success-subtitle">Merci pour votre commande. Vous allez recevoir une confirmation par email.</p>

    <% if @order %>
      <div class="order-summary-card">
        <div class="order-ref">
          <span class="label">Référence commande</span>
          <span class="value amber"><%= @order.order_number %></span>
        </div>
        <div class="order-ref">
          <span class="label">Statut</span>
          <span class="value">
            <span class="status-badge status-<%= @order.status %>"><%= @order.status.humanize %></span>
          </span>
        </div>
        <div class="order-ref">
          <span class="label">Total</span>
          <span class="value amber"><%= number_to_currency(@order.total_cents / 100.0, unit: "€", format: "%n %u") %></span>
        </div>
      </div>
    <% end %>

    <div class="success-actions">
      <%= link_to "Voir mes commandes", me_orders_path, class: "btn-primary" %>
      <%= link_to "Retour à la carte", catalog_path, class: "btn-outline" %>
    </div>
  </div>
</div>

<style>
.page-checkout-success { min-height: 70vh; display: flex; align-items: center; justify-content: center; background: #111; padding: 2rem; }
.success-container { text-align: center; max-width: 520px; }
.success-icon { width: 80px; height: 80px; background: #22c55e22; border: 2px solid #22c55e; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #22c55e; margin: 0 auto 1.5rem; }
.success-container h1 { font-size: 2rem; color: #f0ece4; margin-bottom: .75rem; }
.success-subtitle { color: #888; margin-bottom: 2rem; line-height: 1.6; }
.order-summary-card { background: #181818; border: 1px solid #222; border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; text-align: left; }
.order-ref { display: flex; justify-content: space-between; align-items: center; padding: .6rem 0; border-bottom: 1px solid #222; }
.order-ref:last-child { border-bottom: none; }
.order-ref .label { color: #888; font-size: .9rem; }
.order-ref .value { color: #f0ece4; font-weight: 500; }
.order-ref .value.amber { color: #b23a30; }
.success-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.status-badge { padding: .25rem .7rem; border-radius: 12px; font-size: .8rem; background: #22c55e22; color: #22c55e; border: 1px solid #22c55e44; }
</style>
